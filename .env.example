# RecipeHub in Docker: copy to .env next to docker-compose.yml and change these values.

# Database (the db container is created with these)
POSTGRES_USER=recipehub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=recipehub

# A long random string; signs logins and encrypts saved passwords. Make one: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Port on the server (http://<server>:4000)
PORT=4000

# Behind a reverse proxy (Traefik, Nginx Proxy Manager, Caddy): the proxy's address is trusted for
# X-Forwarded-For / X-Forwarded-Proto. The default trusts private networks (Docker, your LAN).
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Backups: a daily backup in /app/data/backups (./data/app/backups on the server), newest 30 kept
BACKUP_ENABLED=true
BACKUP_KEEP=30
# Encrypts saved keys and passwords (AI keys, email password) inside backups.
# Without it, backups still include your settings but leave those out. Make one: openssl rand -base64 32
# IMPORTANT: save this key somewhere safe, away from this server (a password manager).
# It can't be recovered; without it, the keys and passwords in your backups can't be restored.
# BACKUP_KEY=

# Release watcher: the bar at the top of the app when a newer release is published on GitHub.
# UPDATE_REPO=cwland/RecipeHub
# How often is chosen in Settings → Data → Updates; UPDATE_CHECK_HOURS=0 stops the server's own hourly look
# UPDATE_CHECK_HOURS=1
# GITHUB_TOKEN=

# Email: set it up in the app under Settings -> Email (recommended).
# These are only a fallback, used when nothing is saved in the app.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM="RecipeHub <you@gmail.com>"
# APP_URL=https://recipes.example.com   # the address you open the app at (used in emailed links)

# Passkeys work on https:// addresses and localhost, with no setup. Optional: only allow these addresses:
# PASSKEY_ORIGINS=https://recipes.example.com

# OAuth sign-in is set up in the app (Settings > Security). Locked out? Set this to true and restart:
# password sign-in comes back and OAuth turns off. Remove it again once you're in.
# EMERGENCY_DISABLE_OAUTH=true

# Your time zone: the daily meal plan emails and backups go by it (e.g. America/Chicago, Europe/London)
TZ=America/Chicago
