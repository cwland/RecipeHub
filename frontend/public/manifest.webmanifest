{
  "name": "RecipeHub",
  "short_name": "RecipeHub",
  "description": "Your recipes, meal plans and groceries",
  "start_url": "/#/recipes",
  "display": "standalone",
  "background_color": "#f5f7f6",
  "theme_color": "#20b35b",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
