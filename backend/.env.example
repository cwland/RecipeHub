# Copy to backend/.env for running on your Mac (npm run dev).
# With the dev database from docker-compose.dev.yml:
DATABASE_URL=postgresql://recipehub:recipehub@localhost:5432/recipehub
# (Homebrew / Postgres.app instead: postgresql://YOUR_MAC_USERNAME@localhost:5432/recipehub)
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# Used only by `npm test` (it wipes this database each run)
TEST_DATABASE_URL=postgresql://recipehub:recipehub@localhost:5432/recipehub_test

# Photos, backups and logs go in ./data at the top of the repo unless this says otherwise
# DATA_DIR=

BACKUP_ENABLED=true
BACKUP_KEEP=30
# BACKUP_KEY=

# Email fallback, passkeys, OAuth emergency switch, release watcher: see ../.env.example
